--- const { title, subtitle, date } = Astro.props.frontmatter; const formattedDate = new Date(date).toLocaleDateString('es-CO', { year: 'numeric', month: 'long', day: 'numeric' }); --- <html lang="es"> <head> <meta charset="UTF-8" /> <meta name="viewport" content="width=device-width, initial-scale=1.0" /> <title>{title} — Noesis</title> <link rel="preconnect" href="https://fonts.googleapis.com"> <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin> <link href="https://fonts.googleapis.com/css2?family=Carlito:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet"> </head> <body> <header class="site-header"> <a href="/" class="wordmark">Noesis</a> </header> <main> <article> <h1>{title}</h1> {subtitle && <p class="subtitle">{subtitle}</p>} <p class="meta">{formattedDate}</p> <div class="prose"> <slot /> </div> </article> </main> <footer class="site-footer"> <p>Noesis — reflexiones para la conciencia humana en la era de la IA</p> </footer> </body> </html> <style is:global> :root { --color-bg: #FFFFFF; --color-ink: #1A1D29; --color-primary: #1B3B6F; --color-accent: #2E5C8A; --color-muted: #6B7280; --color-divider: #E2E6ED; } * { box-sizing: border-box; } body { background: var(--color-bg); color: var(--color-ink); font-family: 'Carlito', Calibri, Candara, Verdana, sans-serif; margin: 0; line-height: 1.7; -webkit-font-smoothing: antialiased; } .site-header { max-width: 680px; margin: 0 auto; padding: 3rem 1.5rem 1.5rem; } .wordmark { font-family: 'Carlito', Calibri, sans-serif; font-style: italic; font-size: 1.3rem; color: var(--color-primary); text-decoration: none; letter-spacing: 0.02em; } main { max-width: 680px; margin: 0 auto; padding: 1rem 1.5rem 4rem; } h1 { font-size: 2.25rem; font-weight: 700; color: var(--color-ink); margin-bottom: 0.5rem; line-height: 1.25; } .subtitle { font-style: italic; color: var(--color-accent); font-size: 1.15rem; margin-top: 0; margin-bottom: 1rem; } .meta { font-family: 'Carlito', Calibri, sans-serif; font-size: 0.85rem; color: var(--color-muted); border-bottom: 1px solid var(--color-divider); padding-bottom: 1.5rem; margin-bottom: 2rem; } .prose { font-size: 1.15rem; } .prose p { margin-bottom: 1.4rem; } .prose p:first-of-type::first-letter { float: left; font-size: 3.8rem; line-height: 0.85; font-weight: 700; color: var(--color-primary); padding-right: 0.5rem; padding-top: 0.3rem; } .prose a { color: var(--color-accent); } .site-footer { max-width: 680px; margin: 0 auto; padding: 2rem 1.5rem 3rem; border-top: 1px solid var(--color-divider); font-family: 'Carlito', Calibri, sans-serif; font-size: 0.85rem; color: var(--color-muted); } @media (max-width: 600px) { h1 { font-size: 1.75rem; } .prose p:first-of-type::first-letter { font-size: 2.8rem; } } </style>
